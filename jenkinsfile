pipeline {
    agent any

    stages {
        stage('test') {
            steps {

                echo 'testing  ...'
                sh '''
                ./mvn test
                '''
            }

        }
        stage('build'){
           steps{
              echo 'building ...'
              sh'''
                ./mvn clean package -DskipTests
              '''
           }
        }

    }

    post {
        success {
            archiveArtifacts artifacts: 'build/**'
        }
    }
}
