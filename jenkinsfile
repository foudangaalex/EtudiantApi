pipeline {
    agent any

    stages {
        stage('Test') {
            agent {
                docker {
                    image 'maven:3.9.6-eclipse-temurin-21-alpine'
                    reuseNode true
                }
            }
            steps {
                echo 'Testing  ...'
                sh 'mvn test'
            }
        }

        stage('Build') {
            agent {
                docker {
                    image 'maven:3.9.6-eclipse-temurin-21-alpine'
                    reuseNode true
                }
            }
            steps {
                echo 'Building ...'
                sh 'mvn clean package -DskipTests'
            }
        }
    }

    post {
        success {

            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
        }
    }
}
