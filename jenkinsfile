pipeline {
    agent any

    environment {
        // Caches your Maven dependencies inside the Jenkins workspace directory
        MAVEN_OPTS = "-Dmaven.repo.local=${WORKSPACE}/.m2/repository"
    }

    stages {
        stage('Test') {
            agent {
                docker {
                    image 'maven:3.9.6-eclipse-temurin-21-alpine'
                    reuseNode true
                }
            }
            steps {
                echo 'Testing Application...'
                // Use H2 profile if you configured H2 in src/test/resources/application-test.properties
                // sh 'mvn test -Dspring.profiles.active=test'
                sh 'mvn test'
            }
        }

        stage('Build') {
            agent {
                docker {
                    image 'maven:3.9.6-eclipse-temurin-21-alpine'
                    reuseNode true
                }
            }
            steps {
                echo 'Building Executable JAR...'
                sh 'mvn clean package -DskipTests'
            }
        }
    }

    post {
        success {
            echo 'Archiving build artifacts...'
            // Matches your pom.xml <finalName>student</finalName>
            archiveArtifacts artifacts: 'target/student.jar', fingerprint: true
        }
        always {
            // Optional: cleans up workspace files to save disk space on your Jenkins agent
            cleanWs()
        }
    }
}
